[Desktop Entry]
Type=Application
Name=PerfMonPlus
GenericName=System Monitor
Comment=See which process or subsystem is slowing your machine down
Exec=perfmonplus
Icon=perfmonplus
Terminal=false
Categories=System;Monitor;
Keywords=performance;monitor;cpu;memory;task manager;
StartupWMClass=perfmonplus
